# Copy this file to .env (or paste each line into Render → Environment).
# DO NOT commit the real .env file. The .env.example you're reading should
# only hold placeholders, never real secrets.

# ─── Required for the app to start in production ──────────
SECRET_KEY=replace_with_a_64_char_hex_string
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# ─── Google Sign-In ────────────────────────────────────────
GOOGLE_CLIENT_ID=replace_with_your_client_id.apps.googleusercontent.com

# ─── Admin panel ───────────────────────────────────────────
ADMIN_EMAILS=admin1@example.com,admin2@example.com
ADMIN_PASSWORD=replace_with_strong_password

# ─── Live coach view ───────────────────────────────────────
LIVE_VIEW_PASSWORD=replace_with_a_separate_password

# ─── Certificate emails (SendGrid) ─────────────────────────
SENDGRID_API_KEY=SG.replace_with_your_real_key
SENDGRID_FROM_EMAIL=verified-sender@example.com

# ─── Web Push (daily reminders) ────────────────────────────
# Generate with: pip install py-vapid && vapid --gen
VAPID_PUBLIC_KEY=replace_with_your_public_key
VAPID_PRIVATE_KEY=replace_with_your_private_key
VAPID_CLAIM_SUB=mailto:noreply@example.com

# ─── AI assistant fallback (optional) ──────────────────────
OPENROUTER_API_KEY=sk-or-v1-replace
GEMINI_API_KEY=replace_or_leave_empty
